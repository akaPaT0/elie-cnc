<svg width="800" height="500" viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#18181E"/>
      <stop offset="100%" stop-color="#0E0E11"/>
    </linearGradient>
    <linearGradient id="copper" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D4923F"/>
      <stop offset="100%" stop-color="#C27A3D"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#2E2E3A" stroke-width="1" stroke-opacity="0.4"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#bg)"/>
  <rect width="100%" height="100%" fill="url(#grid)"/>

  <!-- CAD Crosshairs & Diamond Icon -->
  <circle cx="400" cy="230" r="70" fill="none" stroke="#C27A3D" stroke-width="1.5" stroke-opacity="0.5" stroke-dasharray="6 4"/>
  <circle cx="400" cy="230" r="30" fill="none" stroke="#C27A3D" stroke-width="1.5"/>
  <line x1="300" y1="230" x2="500" y2="230" stroke="#C27A3D" stroke-width="1" stroke-opacity="0.4"/>
  <line x1="400" y1="130" x2="400" y2="330" stroke="#C27A3D" stroke-width="1" stroke-opacity="0.4"/>

  <!-- Diamond Center -->
  <polygon points="400,218 412,230 400,242 388,230" fill="url(#copper)"/>

  <!-- Brand Typography -->
  <text x="400" y="340" font-family="'Space Grotesk', system-ui, sans-serif" font-size="20" font-weight="700" fill="#E8E4DF" text-anchor="middle" letter-spacing="4">
    ELIE <tspan fill="#C27A3D">CNC</tspan>
  </text>
  <text x="400" y="370" font-family="'JetBrains Mono', monospace" font-size="12" fill="#5C5C66" text-anchor="middle" letter-spacing="2">
    DIGITAL FILE PREVIEW
  </text>
</svg>
